{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{
					"slug": "slate",
					"name": "Slate",
					"color": "#1E2B36"
				},
				{
					"slug": "slate-2",
					"name": "Slate 2",
					"color": "#2D3E4C"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#EEF2F4"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#D6DEE3"
				},
				{
					"slug": "copper",
					"name": "Copper",
					"color": "#A9581F"
				},
				{
					"slug": "copper-2",
					"name": "Copper hover",
					"color": "#C26A2C"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#17212A"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#566673"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "on-dark",
					"name": "Text on dark",
					"color": "#E6ECF0"
				},
				{
					"slug": "on-dark-soft",
					"name": "Soft text on dark",
					"color": "#B9C6CF"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "head",
					"name": "Archivo",
					"fontFamily": "Archivo, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-variable.woff2"
							],
							"fontStretch": "62% 125%"
						}
					]
				},
				{
					"slug": "body",
					"name": "Public Sans",
					"fontFamily": "\"Public Sans\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/public-sans-400.woff2"
							]
						},
						{
							"fontFamily": "Public Sans",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/public-sans-500.woff2"
							]
						},
						{
							"fontFamily": "Public Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/public-sans-600.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.92rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "1.2rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Sub-heading",
					"size": "1.55rem",
					"fluid": false
				},
				{
					"slug": "x-large",
					"name": "Section heading",
					"size": "clamp(2.1rem, 4vw, 3rem)",
					"fluid": false
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(2.8rem, 6.2vw, 5rem)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "8px",
					"size": "8px"
				},
				{
					"slug": "20",
					"name": "16px",
					"size": "16px"
				},
				{
					"slug": "30",
					"name": "24px",
					"size": "24px"
				},
				{
					"slug": "40",
					"name": "32px",
					"size": "32px"
				},
				{
					"slug": "50",
					"name": "48px",
					"size": "48px"
				},
				{
					"slug": "60",
					"name": "64px",
					"size": "64px"
				},
				{
					"slug": "70",
					"name": "Section",
					"size": "clamp(64px, 8vw, 96px)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"left": "24px",
				"right": "24px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--head)",
					"fontWeight": "800",
					"lineHeight": "1.02",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--copper)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "6px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "24px",
						"right": "24px"
					}
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--copper-2)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--copper-2)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--head)",
					"fontWeight": "800",
					"fontSize": "1.45rem"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontWeight": "500",
					"fontSize": "0.98rem"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": []
}
